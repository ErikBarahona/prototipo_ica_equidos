# Copie este archivo como .env en la misma carpeta que docker-compose.yml.
# NUNCA suba .env al repositorio: contiene un secreto.
#
# La clave se obtiene en https://aistudio.google.com/app/apikey
# El navegador nunca la recibe: solo la usa el proxy /api/gemini del servidor.
GEMINI_API_KEY=AIzaSy...reemplace_por_su_clave

# Opcional: puerto interno del proxy Node (por defecto 3000).
# PORT=3000

# Opcional: interfaz donde escucha el proxy. En Docker debe ser 127.0.0.1,
# porque solo Nginx lo consume. Fuera de Docker puede usar 0.0.0.0.
# HOST=127.0.0.1

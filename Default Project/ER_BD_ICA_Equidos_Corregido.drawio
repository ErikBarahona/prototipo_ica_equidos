  <diagram id="ER_ICA_EQUIDOS_CORREGIDO" name="ER_ICA_Equidos_Corregido">
    <mxGraphModel dx="1617" dy="787" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;fontSize=18;fontStyle=1;fillColor=#1F4E79;color=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" value="MODELO ENTIDAD-RELACIÓN - ICA ÉQUIDOS V2 2023 (CORREGIDO)" vertex="1">
          <mxGeometry height="40" width="1500" x="50" y="30" as="geometry" />
        </mxCell>
        <mxCell id="nota1" parent="1" style="text;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=5;" value="NOTAS:&#xa;- Norma: ICA V2 2023 (Secciones 5.4-5.5, Tablas 1,3,4, Capítulos I-II)&#xa;- Pesos libertades: 20/15/30/15/20 (suma 100%)&#xa;- Clasificación exclusiva: Excelente (≥90), Alto (75-89), Medio (50-74), Bajo (&lt;50)&#xa;- Capítulo: C1 (43) / C2 (32) - Crítico, inmutable tras Etapa I&#xa;- version_norma = ICA-V2-2023 por evaluación&#xa;- No eliminación física (soft-delete) + auditoría con valor_anterior/valor_nuevo&#xa;- Trazabilidad: Evaluación → ResultadoLibertad (5) → DetalleRespuesta → EvidenciaFoto/MuestraAnimal" vertex="1">
          <mxGeometry height="120" width="1500" x="50" y="80" as="geometry" />
        </mxCell>
        <mxCell id="fincas" parent="1" style="rounded=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=9;fontStyle=1;align=left;verticalAlign=top;spacing=4;" value="FINCAS&#xa;(id_finca PK, nombre_finca, propietario, direccion, municipio, departamento,&#xa; msnm NOT NULL, tipo ENUM, sistema_productivo ENUM, tipo_productor,&#xa; telefono_contacto, correo_contacto, observaciones, activo, timestamps)" vertex="1">
          <mxGeometry height="120" width="280" x="120" y="280" as="geometry" />
        </mxCell>

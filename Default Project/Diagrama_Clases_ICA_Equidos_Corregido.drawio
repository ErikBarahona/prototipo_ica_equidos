        <mxCell id="titulo" value="DIAGRAMA DE CLASES - ICA ÉQUIDOS V2 2023 (CORREGIDO)&#xa;Terminología: &quot;Libertad&quot; (reemplaza &quot;DimensionBienestar&quot;) | Jerarquía: Evaluacion → ResultadoLibertad(5) → ResultadoIndicador → DetalleRespuesta/Evidencia" style="text;fontSize=16;fontStyle=1;fillColor=#1F4E79;color=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="50" y="30" width="1500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nota" value="NOTAS CORRECCIONES:&#xa;- DimensionBienestar → Libertad (alineado a ICA V2 2023)&#xa;- Capitulo (C1/C2) en Evaluacion e Indicador&#xa;- Nuevas entidades: MuestraAnimal, DocumentoSoporte, PlanMejora, EvidenciaFoto, ResultadoLibertad&#xa;- Pesos: 20/15/30/15/20 | Clasificación exclusiva: ≥90/75-89/50-74/&lt;50&#xa;- Versionado norma: ICA-V2-2023 | Trazabilidad completa" style="text;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="50" y="90" width="1500" height="60" as="geometry" />
        </mxCell>
